        },
        "mode": 420,
        "path": "/etc/kubernetes/pki/ca.crt"
      },
      {
        "contents": {
          "inline": "apiVersion: v1\nkind: Config\nclusters:\n  - name: cluster\n    cluster:\n      server: \"https://api.my-cluster.example.com:6443\"\n      certificate-authority: /etc/kubernetes/pki/ca.crt\nusers:\n  - name: bootstrap\n    user:\n      token: \"abcdef.0123456789abcdef\"\ncontexts:\n  - name: bootstrap\n    context: {cluster: cluster, user: bootstrap}\ncurrent-context: bootstrap\n"
        },
        "mode": 384,
        "path": "/etc/kubernetes/bootstrap-kubelet.conf"
      },
      {
        "contents": {
          "inline": "apiVersion: kubelet.config.k8s.io/v1beta1\nauthentication:\n  anonymous:\n    enabled: false\n  webhook:\n    enabled: true\n  x509:\n    clientCAFile: /etc/kubernetes/pki/ca.crt\nauthorization:\n  mode: Webhook\ncgroupDriver: systemd\nclusterDomain: cluster.local\nkind: KubeletConfiguration\nmaxPods: 110\nresolvConf: /run/systemd/resolve/resolv.conf\nrotateCertificates: true\nserverTLSBootstrap: true\n"
        },
        "mode": 420,
        "path": "/var/lib/kubelet/config.yaml"
      },
      {
        "contents": {
          "source": "https://github.com/flatcar/sysext-bakery/releases/download/kubernetes-v1.37.1/kubernetes-v1.37.1-arm64.raw",
          "verification": {
            "hash": "sha256-2e2a6faf04230c6b719656dbea20b76f1fbf9a5b3e61c0787c0850f052e40f6b"
          }
        },
        "mode": 420,
        "path": "/opt/extensions/kubernetes/kubernetes-v1.37.1-arm64.raw"
      }
    ],
    "links": [
      {
        "hard": false,
        "path": "/etc/extensions/kubernetes.raw",
        "target": "/opt/extensions/kubernetes/kubernetes-v1.37.1-arm64.raw"
      }
    ]
  },
  "systemd": {
    "units": [
      {
        "mask": true,
        "name": "update-engine.service"
      },
      {
        "mask": true,
        "name": "locksmithd.service"
      },
      {
        "dropins": [
          {
            "contents": "# The kubernetes sysext ships kubelet.service and a kubeadm drop-in\n# (10-kubeadm.conf) that this drop-in overrides; the flags are spelled out so\n# that the unit does not depend on the variables of that drop-in.\n[Service]\nEnvironmentFile=-/run/scarpenter/node-ip.env\nExecStart=\nExecStart=/usr/bin/kubelet --bootstrap-kubeconfig=/etc/kubernetes/bootstrap-kubelet.conf --kubeconfig=/etc/kubernetes/kubelet.conf --config=/var/lib/kubelet/config.yaml --provider-id=scarpenter://aws/us-east-1/default-abc12 --hostname-override=default-abc12 --register-with-taints=karpenter.sh/unregistered:NoExecute,dedicated=gpu:NoSchedule $SCARPENTER_NODE_IP_ARGS\n",
            "name": "20-scarpenter.conf"
          }
        ],
        "name": "kubelet.service"
      }
    ]
  }
}
