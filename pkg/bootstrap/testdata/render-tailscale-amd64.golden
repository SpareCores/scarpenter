=== network ===
{
  "ignition": {
    "version": "3.4.0"
  },
  "storage": {
    "files": [
      {
        "contents": {
          "source": "https://github.com/flatcar/sysext-bakery/releases/download/tailscale-v1.98.10/tailscale-v1.98.10-x86-64.raw",
          "verification": {
            "hash": "sha256-d28c68ae6ed525bbeed0e95ef68b9f660b3e79eb0ca834ebf481ac86f7a886d4"
          }
        },
        "mode": 420,
        "path": "/opt/extensions/tailscale/tailscale-v1.98.10-x86-64.raw"
      },
      {
        "contents": {
          "inline": "tskey-auth-EXAMPLEEXAMPLE-0123456789abcdefEXAMPLE"
        },
        "mode": 384,
        "path": "/etc/scarpenter/tailscale-authkey"
      },
      {
        "contents": {
          "inline": "tailscale\n"
        },
        "mode": 420,
        "path": "/etc/scarpenter/network-template"
      },
      {
        "contents": {
          "inline": "#!/bin/sh\n# Waits for the node's tailscale IPv4 and hands it to the kubelet.\nset -eu\ni=0\nwhile [ \"$i\" -lt 120 ]; do\n  ip=\"$(/usr/bin/tailscale ip -4 2\u003e/dev/null | head -n 1 || true)\"\n  if [ -n \"$ip\" ]; then\n    mkdir -p /run/scarpenter\n    printf 'SCARPENTER_NODE_IP_ARGS=--node-ip=%s\\n' \"$ip\" \u003e /run/scarpenter/node-ip.env\n    exit 0\n  fi\n  i=$((i + 1))\n  sleep 1\ndone\necho \"no tailscale IPv4 address after 120 s\" \u003e\u00262\nexit 1\n"
        },
        "mode": 493,
        "path": "/opt/scarpenter/bin/wait-for-tailscale-ip"
      }
    ],
    "links": [
      {
        "hard": false,
        "path": "/etc/extensions/tailscale.raw",
        "target": "/opt/extensions/tailscale/tailscale-v1.98.10-x86-64.raw"
      }
    ]
  },
  "systemd": {
    "units": [
      {
        "contents": "[Unit]\nDescription=Join the tailnet and publish the kubelet node IP\nRequires=tailscaled.service\nAfter=tailscaled.service network-online.target\nWants=network-online.target\nBefore=kubelet.service\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=/usr/bin/tailscale up --auth-key=file:/etc/scarpenter/tailscale-authkey --hostname=default-abc12 --accept-dns=false --advertise-tags=tag:k8s-node\nExecStart=/opt/scarpenter/bin/wait-for-tailscale-ip\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "scarpenter-tailscale-up.service"
      },
      {
        "dropins": [
          {
            "contents": "[Unit]\nRequires=scarpenter-tailscale-up.service\nAfter=scarpenter-tailscale-up.service\n",
            "name": "30-tailscale.conf"
          }
        ],
        "name": "kubelet.service"
      }
    ]
  }
}
