=== nvidia ===
{
  "ignition": {
    "version": "3.4.0"
  },
  "storage": {
    "files": [
      {
        "contents": {
          "inline": "nvidia-drivers-570\n"
        },
        "mode": 420,
        "path": "/etc/flatcar/enabled-sysext.conf"
      },
      {
        "contents": {
          "source": "https://github.com/flatcar/sysext-bakery/releases/download/nvidia-runtime-v1.17.9/nvidia-runtime-v1.17.9-x86-64.raw",
          "verification": {
            "hash": "sha256-7863300dc49b353b75ff0bbc835b8651d791832316890e040aa4002a36bdffc3"
          }
        },
        "mode": 420,
        "path": "/opt/extensions/nvidia-runtime/nvidia-runtime-v1.17.9-x86-64.raw"
      },
      {
        "contents": {
          "compression": "gzip",
          "source": "https://mirror.example.com/flatcar/amd64-usr/4757.2.3/flatcar-nvidia-drivers-570.raw.gz",
          "verification": {
            "hash": "sha256-e190e7ec96167d2ffa6039e45a67675d7db3674c2160c33f68ead09d39e47b7a"
          }
        },
        "mode": 420,
        "path": "/etc/flatcar/sysext/flatcar-nvidia-drivers-570-4757.2.3.raw"
      },
      {
        "contents": {
          "inline": "blacklist nouveau\nblacklist nova_core\noptions nvidia-drm modeset=0 fbdev=0\ninstall nvidia-drm /bin/true\noptions nvidia NVreg_DynamicPowerManagement=0x00\n"
        },
        "mode": 420,
        "path": "/etc/modprobe.d/00-scarpenter-nvidia.conf"
      },
      {
        "contents": {
          "inline": "#!/bin/bash\nset -u\nwant_version=$1\nwant_gpus=$2\nnode=$3\nfabric=${4:-}\nfm_unit=scarpenter-nvidia-fabricmanager.service\nfm_journal() {\n  journalctl -o cat --no-pager \"_SYSTEMD_INVOCATION_ID=$(systemctl show -p InvocationID --value \"$fm_unit\")\" 2\u003e\u00261\n}\nretry() {\n  local tries=$1 fail\n  shift\n  for _ in $(seq \"$tries\"); do\n    fail=$(\"$@\")\n    [ -z \"$fail\" ] \u0026\u0026 return 0\n    sleep 3\n  done\n  echo \"scarpenter-nvidia-check: $fail; the node is labelled gpu-ready=false\" \u003e\u00262\n  return 1\n}\ncheck_gpus() {\n  if ! grep -qF \" $want_version \" /proc/driver/nvidia/version 2\u003e/dev/null; then\n    echo \"the loaded NVIDIA driver is not $want_version ($(head -n 1 /proc/driver/nvidia/version 2\u003e\u00261))\"\n    return\n  fi\n  local gpus\n  gpus=$(nvidia-smi -L 2\u003e\u00261 | grep -c '^GPU ')\n  if [ \"$gpus\" -ne \"$want_gpus\" ]; then\n    echo \"nvidia-smi lists $gpus GPUs, the instance type has $want_gpus\"\n  fi\n}\ncheck_fabric() {\n  if ! fm_journal | grep -qF \"Successfully configured all the available \"; then\n    echo \"Fabric Manager has not configured the NVSwitches ($(fm_journal | tail -n 1))\"\n  fi\n}\nset_ready() {\n  until kubectl --kubeconfig /etc/kubernetes/kubelet.conf --request-timeout=10s label node \"$node\" \\\n    \"scarpenter.sparecores.com/gpu-ready=$1\" --overwrite; do\n    sleep 3\n  done\n}\nif ! { retry 10 check_gpus \u0026\u0026 { [ -z \"$fabric\" ] || retry 200 check_fabric; }; }; then\n  set_ready false\n  exit 1\nfi\nset_ready true\n"
        },
        "mode": 493,
        "path": "/opt/scarpenter/bin/scarpenter-nvidia-check"
      }
    ],
    "links": [
      {
        "hard": false,
        "path": "/etc/extensions/nvidia-runtime.raw",
        "target": "/opt/extensions/nvidia-runtime/nvidia-runtime-v1.17.9-x86-64.raw"
      }
    ]
  },
  "systemd": {
    "units": [
      {
        "contents": "[Unit]\nDescription=Make runc the default runtime of the nvidia containerd config\nAfter=systemd-tmpfiles-setup.service\nBefore=containerd.service\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=/usr/bin/sed -i 's/\\(default_runtime_name = \\)\"nvidia\"/\\1\"runc\"/' /etc/containerd/config-nvidia.toml\nExecStart=/usr/bin/grep -qx 'default_runtime_name = \"runc\"' /etc/containerd/config-nvidia.toml\n[Install]\nRequiredBy=containerd.service\n",
        "enabled": true,
        "name": "scarpenter-nvidia-containerd.service"
      },
      {
        "contents": "[Unit]\nDescription=Unload nouveau if the initrd loaded it\nConditionPathExists=/sys/module/nouveau\nBefore=nvidia.service\n[Service]\nType=oneshot\nExecStart=-/usr/sbin/rmmod nouveau\n[Install]\nWantedBy=nvidia.service\n",
        "enabled": true,
        "name": "scarpenter-nvidia-prepare.service"
      },
      {
        "contents": "[Unit]\nDescription=Check the NVIDIA driver and the GPUs, then let the node take GPU Pods\nRequires=nvidia.service\nAfter=nvidia.service\n[Service]\nType=oneshot\nRemainAfterExit=yes\nTimeoutStartSec=1200\nExecStart=/opt/scarpenter/bin/scarpenter-nvidia-check 570.211.01 1 default-abc12\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "scarpenter-nvidia-check.service"
      },
      {
        "dropins": [
          {
            "contents": "[Unit]\nUpholds=nvidia-persistenced.service\n",
            "name": "30-scarpenter-nvidia.conf"
          }
        ],
        "name": "multi-user.target"
      }
    ]
  }
}
=== network ===
{
  "ignition": {
    "version": "3.4.0"
  },
  "storage": {
    "files": [
      {
        "contents": {
          "source": "https://github.com/flatcar/sysext-bakery/releases/download/tailscale-v1.98.10/tailscale-v1.98.10-x86-64.raw",
          "verification": {
            "hash": "sha256-d28c68ae6ed525bbeed0e95ef68b9f660b3e79eb0ca834ebf481ac86f7a886d4"
          }
        },
        "mode": 420,
        "path": "/opt/extensions/tailscale/tailscale-v1.98.10-x86-64.raw"
      },
      {
        "contents": {
          "inline": "tskey-auth-EXAMPLEEXAMPLE-0123456789abcdefEXAMPLE"
        },
        "mode": 384,
        "path": "/etc/scarpenter/tailscale-authkey"
      },
      {
        "contents": {
          "inline": "tailscale\n"
        },
        "mode": 420,
        "path": "/etc/scarpenter/network-template"
      },
      {
        "contents": {
          "inline": "#!/bin/sh\n# Waits for the node's tailscale IPv4 and hands it to the kubelet.\nset -eu\ni=0\nwhile [ \"$i\" -lt 120 ]; do\n  ip=\"$(/usr/bin/tailscale ip -4 2\u003e/dev/null | head -n 1 || true)\"\n  if [ -n \"$ip\" ]; then\n    mkdir -p /run/scarpenter\n    printf 'SCARPENTER_NODE_IP_ARGS=--node-ip=%s\\n' \"$ip\" \u003e /run/scarpenter/node-ip.env\n    exit 0\n  fi\n  i=$((i + 1))\n  sleep 1\ndone\necho \"no tailscale IPv4 address after 120 s\" \u003e\u00262\nexit 1\n"
        },
        "mode": 493,
        "path": "/opt/scarpenter/bin/wait-for-tailscale-ip"
      }
    ],
    "links": [
      {
        "hard": false,
        "path": "/etc/extensions/tailscale.raw",
        "target": "/opt/extensions/tailscale/tailscale-v1.98.10-x86-64.raw"
      }
    ]
  },
  "systemd": {
    "units": [
      {
        "contents": "[Unit]\nDescription=Join the tailnet and publish the kubelet node IP\nRequires=tailscaled.service\nAfter=tailscaled.service network-online.target\nWants=network-online.target\nBefore=kubelet.service\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=/usr/bin/tailscale up --auth-key=file:/etc/scarpenter/tailscale-authkey --hostname=default-abc12 --accept-dns=false --advertise-tags=tag:k8s-node $SCARPENTER_TAILSCALE_UP_ARGS\nExecStart=/opt/scarpenter/bin/wait-for-tailscale-ip\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "scarpenter-tailscale-up.service"
      },
      {
        "dropins": [
          {
            "contents": "[Unit]\nRequires=scarpenter-tailscale-up.service\nAfter=scarpenter-tailscale-up.service\n",
            "name": "30-tailscale.conf"
          }
        ],
        "name": "kubelet.service"
      }
    ]
  }
}
