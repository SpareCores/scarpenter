variant: flatcar
version: 1.1.0
storage:
  files:
    - path: /opt/scarpenter/bin/scarpenter-interruption-agent
      mode: 0755
      contents:
        inline: |
          #!/bin/sh
          scarpenter_check() {
            t=$(curl -sf --max-time 3 -H 'Metadata: true' http://169.254.169.254/metadata/scheduledevents) || return 2
            echo "$t" | grep -q Preempt || return 1
            echo "SpotInterrupted $(echo "$t" | sed -n 's/.*"NotBefore": *"\([^"]*\)".*/\1/p')"
          }
          c=${KUBELET_CERT:-/var/lib/kubelet/pki/kubelet-client-current.pem}
          n=$API_SERVER/api/v1/nodes/$NODE_NAME
          a=scarpenter.sparecores.com
          k() { curl -fsS --max-time 10 --cacert "${CLUSTER_CA:-/etc/kubernetes/pki/ca.crt}" --cert "$c" "$@"; }
          while :; do
           o=$(scarpenter_check)
           case $? in
           0)
            set -f
            set -- $o
            r=$(printf %s "${1:-SpotInterrupted}" | tr -cd A-Za-z0-9)
            d=$(printf %s "$2" | tr -cd 0-9A-Za-z:.+-)
            until [ -r "$c" ] && { k "$n" | grep -q $a/interruption-deadline ||
             k -o /dev/null -X PATCH -H 'Content-Type: application/merge-patch+json' "$n" -d \
             "{\"metadata\":{\"annotations\":{\"$a/interruption\":\"$r\",\
          \"$a/interruption-deadline\":\"$d\",\"$a/interruption-source\":\"instance-metadata\"}}}"; }; do
             sleep 1
            done
            echo "$r: node annotated, deadline $d"
            exec sleep infinity ;;
           1) f=; sleep 1 ;;
           *) [ -n "$f" ] || echo "the notice check failed"; f=1; sleep 5 ;;
           esac
          done
    - path: /etc/scarpenter/interruption.env
      mode: 0644
      contents:
        inline: |
          NODE_NAME={{ .NodeName }}
          API_SERVER={{ .APIServerEndpoint }}
systemd:
  units:
    - name: scarpenter-interruption.service
      enabled: true
      contents: |
        [Unit]
        Description=Report the spot interruption notice on this Node
        Wants=network-online.target scarpenter-metadata-firewall.service
        After=network-online.target scarpenter-metadata-firewall.service
        [Service]
        Slice=scarpenter-metadata.slice
        EnvironmentFile=/etc/scarpenter/interruption.env
        ExecStart=/opt/scarpenter/bin/scarpenter-interruption-agent
        Restart=always
        RestartSec=1
        [Install]
        WantedBy=multi-user.target
