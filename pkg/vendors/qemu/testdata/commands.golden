# amd64-kvm
qemu-system-x86_64
  -name
  i-abc
  -daemonize
  -pidfile
  /state/instances/i-abc/qemu.pid
  -display
  none
  -monitor
  none
  -global
  ICH9-LPC.disable_s3=1
  -global
  driver=cfi.pflash01,property=secure,value=on
  -machine
  q35,accel=kvm,smm=on
  -cpu
  host
  -smp
  2
  -m
  4096
  -drive
  if=pflash,unit=0,file=/cache/code.qcow2,format=qcow2,readonly=on
  -drive
  if=pflash,unit=1,file=/state/instances/i-abc/efi-vars.qcow2,format=qcow2
  -drive
  if=none,id=root,format=qcow2,file=/state/instances/i-abc/root.qcow2
  -device
  virtio-blk-pci,drive=root,bootindex=1
  -drive
  if=none,id=disk0,format=qcow2,file=/state/instances/i-abc/data-0.qcow2
  -device
  virtio-blk-pci,drive=disk0,serial=scvfeedface0123
  -drive
  if=none,id=disk1,format=qcow2,file=/state/instances/i-abc/local-0.qcow2
  -device
  virtio-blk-pci,drive=disk1,serial=scl0
  -netdev
  tap,id=net0,ifname=sctdeadbeef,script=no,downscript=no
  -device
  virtio-net-pci,netdev=net0,mac=52:54:00:01:02:03
  -object
  rng-random,filename=/dev/urandom,id=rng0
  -device
  virtio-rng-pci,rng=rng0
  -fw_cfg
  name=opt/org.flatcar-linux/config,file=/state/instances/i-abc/ignition.json
  -serial
  file:/state/instances/i-abc/serial.log
