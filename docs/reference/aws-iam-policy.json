{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Describe",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeCapacityReservations",
        "ec2:DescribeImages",
        "ec2:DescribeInstanceTypeOfferings",
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeInstances",
        "ec2:DescribeInternetGateways",
        "ec2:DescribePlacementGroups",
        "ec2:DescribeRegions",
        "ec2:DescribeRouteTables",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSpotInstanceRequests",
        "ec2:DescribeSubnets",
        "ec2:DescribeVpcs"
      ],
      "Resource": "*"
    },
    {
      "Sid": "QuotaLimits",
      "Effect": "Allow",
      "Action": [
        "servicequotas:GetServiceQuota",
        "servicequotas:ListServiceQuotas"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RunInstancesTaggedResources",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": [
        "arn:aws:ec2:*:123456789012:instance/*",
        "arn:aws:ec2:*:123456789012:volume/*",
        "arn:aws:ec2:*:123456789012:network-interface/*",
        "arn:aws:ec2:*:123456789012:spot-instances-request/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/scarpenter.sparecores.com/cluster": "CLUSTER_NAME"
        }
      }
    },
    {
      "Sid": "RunInstancesUsedResources",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": [
        "arn:aws:ec2:*::image/*",
        "arn:aws:ec2:*::snapshot/*",
        "arn:aws:ec2:*:123456789012:subnet/*",
        "arn:aws:ec2:*:123456789012:security-group/*",
        "arn:aws:ec2:*:123456789012:placement-group/*"
      ]
    },
    {
      "Sid": "TagAtCreation",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags"
      ],
      "Resource": [
        "arn:aws:ec2:*:123456789012:instance/*",
        "arn:aws:ec2:*:123456789012:volume/*",
        "arn:aws:ec2:*:123456789012:network-interface/*",
        "arn:aws:ec2:*:123456789012:spot-instances-request/*",
        "arn:aws:ec2:*:123456789012:security-group/*",
        "arn:aws:ec2:*:123456789012:placement-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": [
            "RunInstances",
            "CreateSecurityGroup",
            "CreatePlacementGroup"
          ],
          "aws:RequestTag/scarpenter.sparecores.com/cluster": "CLUSTER_NAME"
        }
      }
    },
    {
      "Sid": "TerminateInstances",
      "Effect": "Allow",
      "Action": [
        "ec2:TerminateInstances"
      ],
      "Resource": [
        "arn:aws:ec2:*:123456789012:instance/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/scarpenter.sparecores.com/cluster": "CLUSTER_NAME"
        }
      }
    },
    {
      "Sid": "CreateSecurityGroups",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSecurityGroup"
      ],
      "Resource": [
        "arn:aws:ec2:*:123456789012:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/scarpenter.sparecores.com/cluster": "CLUSTER_NAME"
        }
      }
    },
    {
      "Sid": "CreateSecurityGroupsInAVpc",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSecurityGroup"
      ],
      "Resource": [
        "arn:aws:ec2:*:123456789012:vpc/*"
      ]
    },
    {
      "Sid": "ChangeSecurityGroups",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:DeleteSecurityGroup"
      ],
      "Resource": [
        "arn:aws:ec2:*:123456789012:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/scarpenter.sparecores.com/cluster": "CLUSTER_NAME"
        }
      }
    },
    {
      "Sid": "CreatePlacementGroups",
      "Effect": "Allow",
      "Action": [
        "ec2:CreatePlacementGroup"
      ],
      "Resource": [
        "arn:aws:ec2:*:123456789012:placement-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/scarpenter.sparecores.com/cluster": "CLUSTER_NAME"
        }
      }
    },
    {
      "Sid": "DeletePlacementGroups",
      "Effect": "Allow",
      "Action": [
        "ec2:DeletePlacementGroup"
      ],
      "Resource": [
        "arn:aws:ec2:*:123456789012:placement-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/scarpenter.sparecores.com/cluster": "CLUSTER_NAME"
        }
      }
    },
    {
      "Sid": "OptionalManagedNetworkCreate",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpc",
        "ec2:CreateSubnet",
        "ec2:CreateInternetGateway",
        "ec2:CreateRouteTable"
      ],
      "Resource": [
        "arn:aws:ec2:*:123456789012:vpc/*",
        "arn:aws:ec2:*:123456789012:subnet/*",
        "arn:aws:ec2:*:123456789012:internet-gateway/*",
        "arn:aws:ec2:*:123456789012:route-table/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/scarpenter.sparecores.com/cluster": "CLUSTER_NAME"
        }
      }
    },
    {
      "Sid": "OptionalManagedNetworkTagAtCreation",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags"
      ],
      "Resource": [
        "arn:aws:ec2:*:123456789012:vpc/*",
        "arn:aws:ec2:*:123456789012:subnet/*",
        "arn:aws:ec2:*:123456789012:internet-gateway/*",
        "arn:aws:ec2:*:123456789012:route-table/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": [
            "CreateVpc",
            "CreateSubnet",
            "CreateInternetGateway",
            "CreateRouteTable"
          ],
          "aws:RequestTag/scarpenter.sparecores.com/cluster": "CLUSTER_NAME"
        }
      }
    },
    {
      "Sid": "OptionalManagedNetworkChange",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSubnet",
        "ec2:CreateRouteTable",
        "ec2:AttachInternetGateway",
        "ec2:DetachInternetGateway",
        "ec2:CreateRoute",
        "ec2:AssociateRouteTable",
        "ec2:DisassociateRouteTable",
        "ec2:DeleteRouteTable",
        "ec2:DeleteInternetGateway",
        "ec2:DeleteSubnet",
        "ec2:DeleteVpc"
      ],
      "Resource": [
        "arn:aws:ec2:*:123456789012:vpc/*",
        "arn:aws:ec2:*:123456789012:subnet/*",
        "arn:aws:ec2:*:123456789012:internet-gateway/*",
        "arn:aws:ec2:*:123456789012:route-table/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/scarpenter.sparecores.com/cluster": "CLUSTER_NAME"
        }
      }
    },
    {
      "Sid": "OptionalPassInstanceProfileRole",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::123456789012:role/NODE_ROLE_NAME"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    },
    {
      "Sid": "OptionalCustomerKmsKey",
      "Effect": "Allow",
      "Action": [
        "kms:CreateGrant",
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:GenerateDataKeyWithoutPlaintext"
      ],
      "Resource": [
        "arn:aws:kms:*:123456789012:key/KEY_ID"
      ],
      "Condition": {
        "StringLike": {
          "kms:ViaService": "ec2.*.amazonaws.com"
        }
      }
    }
  ]
}
