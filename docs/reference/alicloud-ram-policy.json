{
  "Version": "1",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeRegions",
        "ecs:DescribeZones",
        "ecs:DescribeInstanceTypes",
        "ecs:DescribeAvailableResource",
        "ecs:DescribeAccountAttributes",
        "ecs:DescribeImages",
        "ecs:DescribeInstances",
        "ecs:DescribeSecurityGroups",
        "ecs:DescribeSecurityGroupAttribute",
        "ecs:DescribeDeploymentSets",
        "ecs:ListTagResources",
        "vpc:DescribeVpcs",
        "vpc:DescribeVSwitches"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "ecs:RunInstances",
        "ecs:CreateSecurityGroup",
        "ecs:TagResources",
        "vpc:CreateVpc",
        "vpc:CreateVSwitch"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "acs:RequestTag/scarpenter.sparecores.com/cluster": "my-cluster"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ecs:DeleteInstance",
        "ecs:DeleteSecurityGroup",
        "ecs:AuthorizeSecurityGroup",
        "ecs:RevokeSecurityGroup",
        "vpc:DeleteVpc",
        "vpc:DeleteVSwitch"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "acs:ResourceTag/scarpenter.sparecores.com/cluster": "my-cluster"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ecs:CreateDeploymentSet",
        "ecs:DeleteDeploymentSet"
      ],
      "Resource": "acs:ecs:*:*:deploymentset/*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "ecs:RunInstances",
        "ecs:DeleteInstance"
      ],
      "Resource": [
        "acs:ecs:*:*:image/*",
        "acs:ecs:*:*:securitygroup/*",
        "acs:ecs:*:*:deploymentset/*",
        "acs:vpc:*:*:vswitch/*"
      ]
    }
  ]
}
